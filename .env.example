# Next.js serves the API on the same localhost origin as the frontend.
# SQLite metadata and private image/model files are kept outside /public.
DATABASE_PATH=./storage/trellis.sqlite
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760

# Local TripoSR clone and isolated Python environment.
# Defaults resolve to ~/Desktop/TripoSR and ./.venv-triposr/Scripts/python.exe.
TRIPOSR_REPO=
TRIPOSR_PYTHON=

# Set this only after downloading the official config.yaml and model.ckpt files.
# The app does not automatically download the 1.68 GB checkpoint.
TRIPOSR_MODEL_DIR=
TRIPOSR_CHUNK_SIZE=4096
TRIPOSR_MC_RESOLUTION=256
TRIPOSR_TIMEOUT_MS=900000
MAX_GENERATED_ASSET_BYTES=268435456

# Optional isolated Hunyuan3D-2mini shape-only worker. Paths are local and ignored.
# HUNYUAN_PYTHON defaults to ./.uv-cache/hunyuan3d-env/Scripts/python.exe.
# HUNYUAN_SOURCE defaults to ./.uv-cache/Hunyuan3D-2-source.
# HY3DGEN_MODELS defaults to ./.uv-cache/hy3dgen-models.
HUNYUAN_PYTHON=
HUNYUAN_SOURCE=
HY3DGEN_MODELS=
HUNYUAN_TIMEOUT_MS=1200000
